# Copie para .env na raiz do CPAFrontend.
# Configurações públicas: Vite lê no build; Docker lê ao iniciar o contêiner.
# Segredos de banco, Gmail e chave mestra ficam somente no .env do CPABackend.

# API e login administrativo, acessíveis pelo navegador.
# Portas alinhadas ao .env.example do backend para execução via Docker Compose.
VITE_API_BASE_URL=http://localhost:8081
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=cpa
VITE_KEYCLOAK_CLIENT_ID=cpa-frontend
VITE_CPA_CAMPAIGN_UNAVAILABLE_MESSAGE="A pesquisa está indisponível no momento. Tente novamente mais tarde."

# Porta externa do Nginx no Compose. Não altera a porta do Vite (5173).
FRONTEND_PORT=5175

# Testes E2E: exporte no terminal, pois Playwright não lê automaticamente este .env.
PLAYWRIGHT_CHANNEL=msedge

# Domínios do ambiente de teste da imagem: substitua as URLs locais acima.
# VITE_API_BASE_URL=https://teste.bc.cpafemass.com.br
# VITE_KEYCLOAK_URL=https://teste.auth.cpafemass.com.br
# No backend, alinhe CORS e KEYCLOAK_FRONTEND_URL com https://teste.cpafemass.com.br.

# Backend Java local: se não publicar a API em 8081, use a porta real do processo.
# VITE_API_BASE_URL=http://localhost:8080
# Para o Vite local, use http://localhost:5173 no CORS e no cliente Keycloak.

# Obsoleta: a pesquisa seleciona a campanha automaticamente pelo período.
# VITE_CPA_CAMPAIGN=cpa-2026
